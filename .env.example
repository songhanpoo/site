# Database Connection URLs
# DATABASE_URL is used for the application connection (connection pooling URL, e.g., Supabase transaction pooler)
DATABASE_URL="postgresql://user:password@host:6543/dbname?pgbouncer=true"
# DIRECT_URL is used for database migrations (direct session-mode connection)
DIRECT_URL="postgresql://user:password@host:5432/dbname"

# GitHub OAuth Credentials
GITHUB_CLIENT_ID="your_github_client_id"
GITHUB_CLIENT_SECRET="your_github_client_secret"

# Application Settings
BASE_URL="http://localhost:5173"

# Mapbox Configuration
PUBLIC_MAPBOX_ACCESS_TOKEN="your_mapbox_public_token"
